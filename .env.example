# Copy to .env and fill in values. Never commit the real .env.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/extreme_wordle?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/extreme_wordle_test?schema=public"

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))") ---
SESSION_SECRET=""
SEED_SECRET=""
CRON_SECRET=""

# --- Admin bootstrap (used by prisma/seed.ts) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Arena Admin"

# Optional: create demo accounts (user@demo.local etc.) with a well-known password.
# Leave unset on production databases.
SEED_DEMO_USERS=""

# --- Optional tuning ---
# Credential attempts allowed per IP + email within 10 minutes (default 30).
AUTH_RATE_LIMIT="30"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Google sign-in (leave blank to hide the Google button) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback when unset
GOOGLE_REDIRECT_URI=""

# --- Email (password reset codes) ---
# console = print to the server log, file = append to .mail-outbox.log (tests), resend = deliver
MAIL_PROVIDER="console"
MAIL_FROM="Wordle Arena <onboarding@resend.dev>"
RESEND_API_KEY=""

# --- Cloudflare Turnstile captcha (leave blank to bypass in development) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Password reset throttles (per hour) ---
# Per address, and per IP (generous by default because offices/schools share IPs).
RESET_REQUESTS_PER_EMAIL_PER_HOUR="3"
RESET_REQUESTS_PER_IP_PER_HOUR="30"

# --- Arena (override only for testing; defaults are 12s / 5s / 3s / 6 rounds) ---
ARENA_ROUND_MS="12000"
ARENA_BREAK_MS="5000"
ARENA_COUNTDOWN_MS="3000"
ARENA_ROUND_COUNT="6"