# Copy to .env and fill in values. Never commit the real .env.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/extreme_wordle?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/extreme_wordle_test?schema=public"

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))") ---
SESSION_SECRET=""
SEED_SECRET=""
CRON_SECRET=""

# --- Admin bootstrap (used by prisma/seed.ts) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Bubble Admin"

# --- Optional tuning ---
# Credential attempts allowed per IP + email within 10 minutes (default 30).
AUTH_RATE_LIMIT="30"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
