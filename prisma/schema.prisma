// Extreme Wordle - Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------- Enums -------------------------------

enum Role {
  USER
  ADMIN
}

enum PuzzleSource {
  AUTO
  MANUAL
}

enum GameMode {
  DAILY
  UNLIMITED
  INTERVAL
}

enum ConsentType {
  ANALYTICS
  MARKETING
}

// ------------------------------- Arena -------------------------------

enum League {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum ArenaMode {
  DUEL
  TRIO
}

enum ArenaMatchStatus {
  PLAYING
  FINISHED
  ABANDONED
}

enum ArenaQueueStatus {
  WAITING
  MATCHED
  CANCELLED
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

enum PresenceStatus {
  BROWSING
  IN_MATCH
}

// ------------------------------- Auth -------------------------------

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  username         String
  passwordHash     String?
  name             String?
  role             Role      @default(USER)
  isBanned         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?
  passwordUpdatedAt DateTime?

  // OAuth
  googleId String? @unique

  // Arena profile
  avatarConfig Json?
  rankPoints   Int    @default(0)
  league       League @default(BRONZE)
  wins         Int    @default(0)
  losses       Int    @default(0)
  draws        Int    @default(0)
  matchesPlayed Int   @default(0)
  currentStreak Int   @default(0)
  bestStreak    Int   @default(0)

  sessions    Session[]
  gameResults GameResult[]
  auditLogs   AdminAuditLog[] @relation("AdminAuditLogs")
  createdWords     DailyPuzzle[]  @relation("CreatedWords")
  createdRotations PoolRotation[] @relation("CreatedRotations")
  consents    ConsentRecord[]
  arenaPlayers ArenaPlayer[]
  arenaQueue   ArenaQueue[]
  presence     Presence[]

  @@unique([username])
  @@index([role])
  @@index([createdAt])
  @@index([rankPoints])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model GuestSession {
  id                String   @id @default(cuid())
  token             String   @unique
  ip                String?
  userAgent         String?
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  convertedToUserId String?

  gameResults GameResult[]
  consents    ConsentRecord[]
  arenaPlayers ArenaPlayer[]
  arenaQueue   ArenaQueue[]
  presence     Presence[]

  @@index([createdAt])
}

// ------------------------------- Games -------------------------------

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String?
  description String?
  thumbnail   String?
  category    String   @default("word")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wordEntries  WordEntry[]
  puzzles      GamePuzzle[]
  dailyPuzzles DailyPuzzle[]
  rotations    PoolRotation[]
  gameResults  GameResult[]
  arenaMatches ArenaMatch[]

  @@index([isActive, sortOrder])
}

model WordEntry {
  id           String   @id @default(cuid())
  gameId       String
  word         String
  normalized   String
  length       Int?
  difficulty   Int?
  isAnswerPool Boolean  @default(true)
  isActive     Boolean  @default(true)
  tags         String[] @default([])
  createdAt    DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, normalized])
  @@index([gameId, isAnswerPool, isActive])
}

// Structured puzzles (Connections groups, Spelling Bee letter sets, ...).
// `externalId` is the stable token stored on DailyPuzzle.word.
model GamePuzzle {
  id         String   @id @default(cuid())
  gameId     String
  externalId String
  title      String?
  difficulty Int      @default(0)
  payload    Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, externalId])
  @@index([gameId, isActive, difficulty])
}

model PoolRotation {
  id               String       @id @default(cuid())
  gameId           String
  bucketKey        String
  seed             String
  source           PuzzleSource @default(AUTO)
  createdByAdminId String?
  createdAt        DateTime     @default(now())

  game     Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  admin    User? @relation("CreatedRotations", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@unique([gameId, bucketKey])
  @@index([bucketKey])
}

model DailyPuzzle {
  id               String       @id @default(cuid())
  gameId           String
  bucketKey        String
  word             String
  normalized       String
  source           PuzzleSource @default(AUTO)
  createdByAdminId String?
  publishedAt      DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  admin User? @relation("CreatedWords", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  gameResults GameResult[]

  @@unique([gameId, bucketKey])
  @@index([bucketKey])
  @@index([gameId, publishedAt])
}

model GameResult {
  id          String    @id @default(cuid())
  gameId      String
  userId      String?
  guestId     String?
  puzzleId    String?
  mode        GameMode  @default(DAILY)
  bucketKey   String?
  answer      String?
  guesses     Json      @default("[]")
  solved      Boolean   @default(false)
  attempts    Int       @default(0)
  durationMs  Int?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  game   Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  guest  GuestSession? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  puzzle DailyPuzzle? @relation(fields: [puzzleId], references: [id], onDelete: SetNull)

  @@index([gameId, createdAt])
  @@index([userId, gameId])
  @@index([guestId, gameId])
  @@index([mode, bucketKey])
}

// ------------------------------- Admin / Ops -------------------------------

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  targetType String?
  targetId   String?
  meta       Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  admin User? @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
}

model ConsentRecord {
  id         String      @id @default(cuid())
  userId     String?
  guestId    String?
  type       ConsentType
  granted    Boolean     @default(true)
  version    String      @default("1")
  createdAt  DateTime    @default(now())

  user  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  guest GuestSession? @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([guestId])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ------------------------------- Arena -------------------------------

/**
 * One live or finished 1v1 duel. Round timing is derived from `startedAt` so no
 * background worker is needed — see `src/lib/arena/clock.ts`.
 */
model ArenaMatch {
  id              String           @id @default(cuid())
  mode            ArenaMode        @default(DUEL)
  status          ArenaMatchStatus @default(PLAYING)
  gameId          String
  word            String
  roundCount      Int              @default(6)
  roundMs         Int              @default(12000)
  breakMs         Int              @default(5000)
  countdownMs     Int              @default(3000)
  startedAt       DateTime         @default(now())
  finishedAt      DateTime?
  winnerPlayerId  String?
  isDraw          Boolean          @default(false)
  /** True when any participant is a guest or bot: excluded from rank points. */
  isCasual        Boolean          @default(false)
  endReason       String?
  version         Int              @default(1)
  rematchOfId     String?
  createdAt       DateTime         @default(now())

  game      Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  players   ArenaPlayer[]
  guesses   ArenaGuess[]
  reactions ArenaReaction[]

  @@index([status, startedAt])
  @@index([createdAt])
}

model ArenaPlayer {
  id           String       @id @default(cuid())
  matchId      String
  slot         Int
  userId       String?
  guestId      String?
  isBot        Boolean      @default(false)
  displayName  String
  username     String?
  /** Deterministic avatar seed for guests and bots. */
  avatarSeed   String?
  league       League       @default(BRONZE)
  pointsBefore Int          @default(0)
  pointsAfter  Int          @default(0)
  pointsDelta  Int          @default(0)
  result       MatchResult?
  solvedRound  Int?
  solvedAt     DateTime?
  bestGreens   Int          @default(0)
  bestYellows  Int          @default(0)
  bestAt       DateTime?
  lastSeenAt   DateTime     @default(now())
  joinedAt     DateTime     @default(now())

  match   ArenaMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  guest   GuestSession? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guesses ArenaGuess[]

  @@unique([matchId, slot])
  @@index([matchId])
  @@index([userId])
  @@index([guestId])
}

/** Exactly one locked guess per player per round. */
model ArenaGuess {
  id         String   @id @default(cuid())
  matchId    String
  playerId   String
  round      Int
  guess      String
  feedback   Json     @default("[]")
  correct    Boolean  @default(false)
  receivedAt DateTime @default(now())

  match  ArenaMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player ArenaPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, round])
  @@index([matchId, round])
}

model ArenaReaction {
  id        String   @id @default(cuid())
  matchId   String
  playerId  String
  emoji     String
  createdAt DateTime @default(now())

  match ArenaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

model ArenaQueue {
  id          String            @id @default(cuid())
  userId      String?
  guestId     String?
  displayName String
  username    String?
  avatarSeed  String?
  league      League            @default(BRONZE)
  status      ArenaQueueStatus  @default(WAITING)
  matchId     String?
  joinedAt    DateTime          @default(now())
  lastSeenAt  DateTime          @default(now())

  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest GuestSession? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([status, joinedAt])
  @@index([userId])
  @@index([guestId])
}

/** Hashed, single-use password reset codes. */
model PasswordResetOtp {
  id         String    @id @default(cuid())
  email      String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  requestIp  String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

/** Lightweight heartbeat used to render the "N online" counter. */
model Presence {
  id         String         @id @default(cuid())
  key        String         @unique
  userId     String?
  guestId    String?
  status     PresenceStatus @default(BROWSING)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest GuestSession? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([lastSeenAt])
  @@index([status])
}
